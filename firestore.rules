rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Global Primitives
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function authEmail() {
      return request.auth.token.email is string ? request.auth.token.email.lower() : '';
    }

    function isBootstrappedAdmin() {
      return isVerified() && request.auth.token.email == 'ardaffa2000@gmail.com';
    }

    function emailToKey(email) {
      return email.lower().replace('[^a-z0-9]', '_');
    }

    function hasValidRoleInvite(peran) {
      return isVerified()
        && request.auth.token.email is string
        && exists(/databases/$(database)/documents/role_invites/$(emailToKey(request.auth.token.email)))
        && get(/databases/$(database)/documents/role_invites/$(emailToKey(request.auth.token.email))).data.peran == peran;
    }

    function userDocExists() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.peran;
    }

    function isUserActive() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aktif == true;
    }

    function isAdmin() {
      return isBootstrappedAdmin() || (isVerified() && userDocExists() && isUserActive() && userRole() == 'admin');
    }

    function isPetugas() {
      return isVerified() && userDocExists() && isUserActive() && userRole() == 'petugas';
    }

    function isKepsek() {
      return isVerified() && userDocExists() && isUserActive() && userRole() == 'kepala_sekolah';
    }

    function isParent() {
      return isVerified()
        && authEmail().size() >= 3
        && userDocExists()
        && isUserActive()
        && userRole() == 'orang_tua';
    }

    function isStaff() {
      return isAdmin() || isPetugas() || isKepsek();
    }

    function isOperator() {
      return isAdmin() || isPetugas();
    }

    function isOwnedByParentEmail(data) {
      return isParent() && data.emailOrtu == authEmail();
    }

    // 3. Entity Validation Blueprints
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'nama', 'email', 'peran', 'aktif', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'nama', 'email', 'peran', 'aktif', 'catatanAkses', 'hakAksesKhusus', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.peran in ['admin', 'petugas', 'kepala_sekolah', 'orang_tua', 'pending']
        && data.aktif is bool
        && (!('catatanAkses' in data) || (data.catatanAkses is string && data.catatanAkses.size() <= 160))
        && (!('hakAksesKhusus' in data) || (
          data.hakAksesKhusus is map
          && data.hakAksesKhusus.keys().hasOnly(['bolehBatalkanPembayaran', 'bolehGenerateTagihan', 'bolehLihatMaster', 'bolehLihatAudit'])
          && (!('bolehBatalkanPembayaran' in data.hakAksesKhusus) || data.hakAksesKhusus.bolehBatalkanPembayaran is bool)
          && (!('bolehGenerateTagihan' in data.hakAksesKhusus) || data.hakAksesKhusus.bolehGenerateTagihan is bool)
          && (!('bolehLihatMaster' in data.hakAksesKhusus) || data.hakAksesKhusus.bolehLihatMaster is bool)
          && (!('bolehLihatAudit' in data.hakAksesKhusus) || data.hakAksesKhusus.bolehLihatAudit is bool)
        ))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidRoleInvite(data) {
      return data.keys().hasAll(['email', 'nama', 'peran', 'createdBy', 'createdAt'])
        && data.keys().hasOnly(['email', 'nama', 'peran', 'createdBy', 'createdAt'])
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 160
        && data.nama is string && data.nama.size() >= 1 && data.nama.size() <= 120
        && data.peran in ['admin', 'petugas', 'kepala_sekolah', 'orang_tua']
        && data.createdBy == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidPengaturanSekolah(data) {
      return data.keys().hasAll(['namaSekolah', 'alamat', 'telepon', 'email', 'kota', 'namaKepalaSekolah', 'updatedAt'])
        && data.keys().hasOnly(['namaSekolah', 'npsn', 'alamat', 'telepon', 'email', 'kota', 'namaKepalaSekolah', 'nipKepalaSekolah', 'namaBank', 'noRekening', 'atasNamaRekening', 'prefixVaSiswa', 'updatedAt'])
        && data.namaSekolah is string && data.namaSekolah.size() >= 2 && data.namaSekolah.size() <= 160
        && (!('npsn' in data) || (data.npsn is string && data.npsn.size() <= 30))
        && data.alamat is string && data.alamat.size() <= 300
        && data.telepon is string && data.telepon.size() <= 40
        && data.email is string && data.email.size() <= 120
        && data.kota is string && data.kota.size() >= 1 && data.kota.size() <= 80
        && data.namaKepalaSekolah is string && data.namaKepalaSekolah.size() <= 120
        && (!('nipKepalaSekolah' in data) || (data.nipKepalaSekolah is string && data.nipKepalaSekolah.size() <= 40))
        && (!('namaBank' in data) || (data.namaBank is string && data.namaBank.size() <= 80))
        && (!('noRekening' in data) || (data.noRekening is string && data.noRekening.size() <= 60))
        && (!('atasNamaRekening' in data) || (data.atasNamaRekening is string && data.atasNamaRekening.size() <= 120))
        && (!('prefixVaSiswa' in data) || (data.prefixVaSiswa is string && data.prefixVaSiswa.size() <= 12))
        && data.updatedAt is timestamp;
    }

    function isValidPengaturanSistem(data) {
      return data.keys().hasAll([
          'midtransProductionMode', 'midtransAktif', 'transferManualAktif',
          'midtransEnabledPayments', 'midtransOrderPrefix', 'midtransExpiryMenit',
          'portalOrtuAktif', 'petugasBolehBatalkanPembayaran', 'petugasBolehGenerateTagihan',
          'petugasBolehLihatMaster', 'kepsekBolehLihatAudit', 'ortuBolehCicilan',
          'autoGenerateTagihan', 'tanggalJatuhTempo', 'prefixKwitansi',
          'prefixPengajuanOrtu', 'tampilkanNipKepsekDiKwitansi', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'midtransProductionMode', 'midtransAktif', 'transferManualAktif',
          'midtransEnabledPayments', 'midtransOrderPrefix', 'midtransExpiryMenit',
          'portalOrtuAktif', 'pesanPemeliharaanPortal', 'petugasBolehBatalkanPembayaran',
          'petugasBolehGenerateTagihan', 'petugasBolehLihatMaster', 'kepsekBolehLihatAudit',
          'ortuBolehCicilan', 'autoGenerateTagihan', 'tanggalJatuhTempo', 'prefixKwitansi',
          'prefixPengajuanOrtu', 'catatanKakiKwitansi', 'tampilkanNipKepsekDiKwitansi',
          'templateWaTunggakan', 'updatedAt'
        ])
        && data.midtransProductionMode is bool
        && data.midtransAktif is bool
        && data.transferManualAktif is bool
        && data.midtransEnabledPayments is list
        && data.midtransEnabledPayments.size() <= 15
        && (data.midtransEnabledPayments.size() == 0 || (data.midtransEnabledPayments[0] is string && data.midtransEnabledPayments[0].size() <= 40))
        && data.midtransOrderPrefix is string && data.midtransOrderPrefix.size() >= 2 && data.midtransOrderPrefix.size() <= 10
        && data.midtransExpiryMenit is number && data.midtransExpiryMenit >= 15 && data.midtransExpiryMenit <= 10080
        && data.portalOrtuAktif is bool
        && (!('pesanPemeliharaanPortal' in data) || (data.pesanPemeliharaanPortal is string && data.pesanPemeliharaanPortal.size() <= 300))
        && data.petugasBolehBatalkanPembayaran is bool
        && data.petugasBolehGenerateTagihan is bool
        && data.petugasBolehLihatMaster is bool
        && data.kepsekBolehLihatAudit is bool
        && data.ortuBolehCicilan is bool
        && data.autoGenerateTagihan is bool
        && data.tanggalJatuhTempo is number && data.tanggalJatuhTempo >= 1 && data.tanggalJatuhTempo <= 28
        && data.prefixKwitansi is string && data.prefixKwitansi.size() >= 2 && data.prefixKwitansi.size() <= 10
        && data.prefixPengajuanOrtu is string && data.prefixPengajuanOrtu.size() >= 2 && data.prefixPengajuanOrtu.size() <= 10
        && (!('catatanKakiKwitansi' in data) || (data.catatanKakiKwitansi is string && data.catatanKakiKwitansi.size() <= 300))
        && data.tampilkanNipKepsekDiKwitansi is bool
        && (!('templateWaTunggakan' in data) || (data.templateWaTunggakan is string && data.templateWaTunggakan.size() <= 600))
        && data.updatedAt is timestamp;
    }

    function isValidTahunAjaran(data) {
      return data.keys().hasAll(['nama', 'aktif', 'createdAt'])
        && data.keys().hasOnly(['nama', 'aktif', 'createdAt'])
        && data.nama is string && data.nama.size() >= 4 && data.nama.size() <= 30
        && data.aktif is bool
        && data.createdAt is timestamp;
    }

    function isValidKelas(data) {
      return data.keys().hasAll(['nama', 'tingkat', 'tahunAjaranId', 'createdAt'])
        && data.keys().hasOnly(['nama', 'tingkat', 'tahunAjaranId', 'createdAt'])
        && data.nama is string && data.nama.size() >= 2 && data.nama.size() <= 60
        && data.tingkat in ['10', '11', '12']
        && isValidId(data.tahunAjaranId)
        && data.createdAt is timestamp;
    }

    function isValidTarifSpp(data) {
      return data.keys().hasAll(['kelasId', 'tahunAjaranId', 'nominal', 'updatedAt'])
        && data.keys().hasOnly(['kelasId', 'tahunAjaranId', 'nominal', 'updatedAt'])
        && isValidId(data.kelasId)
        && isValidId(data.tahunAjaranId)
        && data.nominal is number && data.nominal >= 0 && data.nominal <= 50000000
        && data.updatedAt is timestamp;
    }

    function isValidSiswa(data) {
      return data.keys().hasAll(['nis', 'nama', 'kelasId', 'statusAktif', 'noHpOrtu', 'diskonTipe', 'diskonNilai', 'keteranganDiskon', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['nis', 'nama', 'kelasId', 'statusAktif', 'noHpOrtu', 'emailOrtu', 'diskonTipe', 'diskonNilai', 'keteranganDiskon', 'createdAt', 'updatedAt'])
        && data.nis is string && data.nis.size() >= 3 && data.nis.size() <= 30
        && data.nama is string && data.nama.size() >= 2 && data.nama.size() <= 120
        && isValidId(data.kelasId)
        && data.statusAktif in ['aktif', 'lulus', 'pindah', 'nonaktif']
        && data.noHpOrtu is string && data.noHpOrtu.size() <= 30
        && (!('emailOrtu' in data) || (data.emailOrtu is string && data.emailOrtu.size() <= 160))
        && data.diskonTipe in ['none', 'nominal', 'persen']
        && data.diskonNilai is number && data.diskonNilai >= 0
        && (data.diskonTipe != 'persen' || data.diskonNilai <= 100)
        && data.keteranganDiskon is string && data.keteranganDiskon.size() <= 160
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidTagihanSpp(data) {
      return data.keys().hasAll(['siswaId', 'kelasId', 'tahunAjaranId', 'bulan', 'tahun', 'nominalTarif', 'nominalDiskon', 'nominalTagihan', 'totalTerbayar', 'sisaTagihan', 'status', 'jatuhTempo', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['siswaId', 'kelasId', 'tahunAjaranId', 'emailOrtu', 'bulan', 'tahun', 'nominalTarif', 'nominalDiskon', 'nominalTagihan', 'totalTerbayar', 'sisaTagihan', 'status', 'jatuhTempo', 'createdAt', 'updatedAt'])
        && isValidId(data.siswaId)
        && isValidId(data.kelasId)
        && isValidId(data.tahunAjaranId)
        && (!('emailOrtu' in data) || (data.emailOrtu is string && data.emailOrtu.size() <= 160))
        && data.bulan is number && data.bulan >= 1 && data.bulan <= 12
        && data.tahun is number && data.tahun >= 2020 && data.tahun <= 2100
        && data.nominalTarif is number && data.nominalTarif >= 0
        && data.nominalDiskon is number && data.nominalDiskon >= 0
        && data.nominalTagihan is number && data.nominalTagihan >= 0
        && data.totalTerbayar is number && data.totalTerbayar >= 0
        && data.sisaTagihan is number && data.sisaTagihan >= 0
        && data.status in ['belum_bayar', 'sebagian', 'lunas']
        && data.jatuhTempo is string && data.jatuhTempo.size() <= 20
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPembayaran(data) {
      return data.keys().hasAll(['noKwitansi', 'siswaId', 'siswaNis', 'siswaNama', 'kelasId', 'kelasNama', 'tanggalBayar', 'metode', 'totalBayar', 'petugasUid', 'petugasNama', 'catatan', 'status', 'alasanBatal', 'dibatalkanOleh', 'dibatalkanPada', 'rincianBulan', 'createdAt'])
        && data.keys().hasOnly(['noKwitansi', 'siswaId', 'siswaNis', 'siswaNama', 'kelasId', 'kelasNama', 'emailOrtu', 'tanggalBayar', 'metode', 'totalBayar', 'petugasUid', 'petugasNama', 'catatan', 'status', 'alasanBatal', 'dibatalkanOleh', 'dibatalkanPada', 'rincianBulan', 'createdAt'])
        && data.noKwitansi is string && data.noKwitansi.size() >= 5 && data.noKwitansi.size() <= 60
        && isValidId(data.siswaId)
        && data.siswaNis is string && data.siswaNis.size() <= 30
        && data.siswaNama is string && data.siswaNama.size() <= 120
        && isValidId(data.kelasId)
        && data.kelasNama is string && data.kelasNama.size() <= 60
        && (!('emailOrtu' in data) || (data.emailOrtu is string && data.emailOrtu.size() <= 160))
        && data.tanggalBayar is string && data.tanggalBayar.size() >= 8 && data.tanggalBayar.size() <= 30
        && data.metode in ['tunai', 'transfer']
        && data.totalBayar is number && data.totalBayar > 0 && data.totalBayar <= 100000000
        && data.petugasUid is string && data.petugasUid.size() >= 1 && data.petugasUid.size() <= 128
        && data.petugasNama is string && data.petugasNama.size() <= 120
        && data.catatan is string && data.catatan.size() <= 300
        && data.status in ['sah', 'dibatalkan']
        && data.alasanBatal is string && data.alasanBatal.size() <= 300
        && data.dibatalkanOleh is string && data.dibatalkanOleh.size() <= 120
        && data.dibatalkanPada is string && data.dibatalkanPada.size() <= 40
        && data.rincianBulan is string && data.rincianBulan.size() <= 500
        && data.createdAt is timestamp;
    }

    function isValidPembayaranDetail(data) {
      return data.keys().hasAll(['pembayaranId', 'tagihanId', 'siswaId', 'bulan', 'tahun', 'nominalDialokasikan', 'status', 'createdAt'])
        && data.keys().hasOnly(['pembayaranId', 'tagihanId', 'siswaId', 'emailOrtu', 'bulan', 'tahun', 'nominalDialokasikan', 'status', 'createdAt'])
        && isValidId(data.pembayaranId)
        && isValidId(data.tagihanId)
        && isValidId(data.siswaId)
        && (!('emailOrtu' in data) || (data.emailOrtu is string && data.emailOrtu.size() <= 160))
        && data.bulan is number && data.bulan >= 1 && data.bulan <= 12
        && data.tahun is number && data.tahun >= 2020 && data.tahun <= 2100
        && data.nominalDialokasikan is number && data.nominalDialokasikan > 0
        && data.status in ['sah', 'dibatalkan']
        && data.createdAt is timestamp;
    }

    function isValidPembayaranOrtu(data) {
      return data.keys().hasAll([
          'kodePengajuan', 'siswaId', 'siswaNis', 'siswaNama', 'kelasId', 'kelasNama',
          'orangTuaUid', 'orangTuaNama', 'emailOrtu', 'tanggalTransfer', 'kanal',
          'namaPengirim', 'referensiTransfer', 'catatan', 'totalBayar', 'rincianBulan',
          'items', 'status', 'pembayaranId', 'noKwitansi', 'diprosesOleh', 'diprosesPada',
          'alasanTolak', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'kodePengajuan', 'siswaId', 'siswaNis', 'siswaNama', 'kelasId', 'kelasNama',
          'orangTuaUid', 'orangTuaNama', 'emailOrtu', 'tanggalTransfer', 'kanal',
          'namaPengirim', 'referensiTransfer', 'catatan', 'totalBayar', 'rincianBulan',
          'items', 'status', 'pembayaranId', 'noKwitansi', 'diprosesOleh', 'diprosesPada',
          'alasanTolak', 'midtransOrderId', 'midtransSnapToken', 'midtransRedirectUrl',
          'midtransTransactionStatus', 'midtransPaymentType', 'createdAt', 'updatedAt'
        ])
        && data.kodePengajuan is string && data.kodePengajuan.size() >= 5 && data.kodePengajuan.size() <= 60
        && isValidId(data.siswaId)
        && data.siswaNis is string && data.siswaNis.size() <= 30
        && data.siswaNama is string && data.siswaNama.size() <= 120
        && isValidId(data.kelasId)
        && data.kelasNama is string && data.kelasNama.size() <= 60
        && data.orangTuaUid is string && data.orangTuaUid.size() >= 1 && data.orangTuaUid.size() <= 128
        && data.orangTuaNama is string && data.orangTuaNama.size() >= 1 && data.orangTuaNama.size() <= 120
        && data.emailOrtu is string && data.emailOrtu.size() >= 3 && data.emailOrtu.size() <= 160
        && data.tanggalTransfer is string && data.tanggalTransfer.size() >= 8 && data.tanggalTransfer.size() <= 30
        && data.kanal in ['midtrans', 'transfer_bank', 'qris', 'virtual_account']
        && data.namaPengirim is string && data.namaPengirim.size() >= 2 && data.namaPengirim.size() <= 120
        && data.referensiTransfer is string && data.referensiTransfer.size() <= 100
        && data.catatan is string && data.catatan.size() <= 300
        && data.totalBayar is number && data.totalBayar > 0 && data.totalBayar <= 100000000
        && data.rincianBulan is string && data.rincianBulan.size() >= 1 && data.rincianBulan.size() <= 500
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 12
        && data.items[0] is map
        && data.items[0].keys().hasAll(['tagihanId', 'bulan', 'tahun', 'bayarNominal'])
        && data.items[0].keys().hasOnly(['tagihanId', 'bulan', 'tahun', 'bayarNominal'])
        && isValidId(data.items[0].tagihanId)
        && data.items[0].bulan is number && data.items[0].bulan >= 1 && data.items[0].bulan <= 12
        && data.items[0].tahun is number && data.items[0].tahun >= 2020 && data.items[0].tahun <= 2100
        && data.items[0].bayarNominal is number && data.items[0].bayarNominal > 0
        && data.status in ['menunggu_verifikasi', 'diverifikasi', 'ditolak']
        && data.pembayaranId is string && data.pembayaranId.size() <= 128
        && data.noKwitansi is string && data.noKwitansi.size() <= 60
        && data.diprosesOleh is string && data.diprosesOleh.size() <= 120
        && data.diprosesPada is string && data.diprosesPada.size() <= 40
        && data.alasanTolak is string && data.alasanTolak.size() <= 300
        && (!('midtransOrderId' in data) || (data.midtransOrderId is string && data.midtransOrderId.size() <= 80))
        && (!('midtransSnapToken' in data) || (data.midtransSnapToken is string && data.midtransSnapToken.size() <= 160))
        && (!('midtransRedirectUrl' in data) || (data.midtransRedirectUrl is string && data.midtransRedirectUrl.size() <= 300))
        && (!('midtransTransactionStatus' in data) || (data.midtransTransactionStatus is string && data.midtransTransactionStatus.size() <= 40))
        && (!('midtransPaymentType' in data) || (data.midtransPaymentType is string && data.midtransPaymentType.size() <= 60))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidLogAktivitas(data) {
      return data.keys().hasAll(['actorUid', 'actorNama', 'actorPeran', 'aksi', 'entitas', 'entitasId', 'ringkasan', 'createdAt'])
        && data.keys().hasOnly(['actorUid', 'actorNama', 'actorPeran', 'aksi', 'entitas', 'entitasId', 'ringkasan', 'createdAt'])
        && data.actorUid == request.auth.uid
        && data.actorNama is string && data.actorNama.size() >= 1 && data.actorNama.size() <= 120
        && data.actorPeran is string && data.actorPeran.size() >= 1 && data.actorPeran.size() <= 40
        && data.aksi in ['CREATE', 'UPDATE', 'DELETE', 'CANCEL', 'GENERATE', 'SEED']
        && data.entitas is string && data.entitas.size() >= 1 && data.entitas.size() <= 60
        && data.entitasId is string && data.entitasId.size() >= 1 && data.entitasId.size() <= 128
        && data.ringkasan is string && data.ringkasan.size() >= 1 && data.ringkasan.size() <= 400
        && data.createdAt is timestamp;
    }

    // 4. Collection Rules
    match /users/{userId} {
      allow get: if isValidId(userId) && isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isValidId(userId)
        && isVerified()
        && request.auth.uid == userId
        && isValidUser(incoming())
        && incoming().uid == userId
        && !('hakAksesKhusus' in incoming())
        && !('catatanAkses' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && (
          (isBootstrappedAdmin() && incoming().peran == 'admin' && incoming().aktif == true) ||
          (hasValidRoleInvite(incoming().peran) && incoming().aktif == true) ||
          (incoming().peran == 'pending' && incoming().aktif == true)
        );
      allow update: if isValidId(userId)
        && isVerified()
        && isValidUser(incoming())
        && incoming().uid == existing().uid
        && incoming().email == existing().email
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['nama', 'updatedAt'])) ||
          (
            request.auth.uid == userId
            && existing().peran == 'pending'
            && hasValidRoleInvite(incoming().peran)
            && incoming().aktif == true
            && incoming().diff(existing()).affectedKeys().hasOnly(['peran', 'aktif', 'updatedAt'])
          )
        );
      allow delete: if false;
    }

    match /role_invites/{inviteId} {
      allow get: if isValidId(inviteId) && isVerified();
      allow list: if isAdmin();
      allow create: if isValidId(inviteId) && isAdmin() && isValidRoleInvite(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(inviteId) && isAdmin() && isValidRoleInvite(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(inviteId) && isAdmin();
    }

    match /pengaturan_sekolah/{settingId} {
      allow get: if isValidId(settingId) && (isStaff() || isParent());
      allow list: if isStaff() || isParent();
      allow create: if isValidId(settingId) && isAdmin() && isValidPengaturanSekolah(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(settingId) && isAdmin() && isValidPengaturanSekolah(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /pengaturan_sistem/{configId} {
      allow get: if isValidId(configId) && (isStaff() || isParent());
      allow list: if isStaff() || isParent();
      allow create: if isValidId(configId) && isAdmin() && isValidPengaturanSistem(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(configId) && isAdmin() && isValidPengaturanSistem(incoming()) && incoming().updatedAt == request.time;
      allow delete: if false;
    }

    match /tahun_ajaran/{tahunAjaranId} {
      allow get: if isValidId(tahunAjaranId) && (isStaff() || isParent());
      allow list: if isStaff() || isParent();
      allow create: if isValidId(tahunAjaranId) && isAdmin() && isValidTahunAjaran(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(tahunAjaranId) && isAdmin() && isValidTahunAjaran(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(tahunAjaranId) && isAdmin();
    }

    match /kelas/{kelasId} {
      allow get: if isValidId(kelasId) && (isStaff() || isParent());
      allow list: if isStaff() || isParent();
      allow create: if isValidId(kelasId) && isAdmin() && isValidKelas(incoming()) && incoming().createdAt == request.time;
      allow update: if isValidId(kelasId) && isAdmin() && isValidKelas(incoming()) && incoming().createdAt == existing().createdAt;
      allow delete: if isValidId(kelasId) && isAdmin();
    }

    match /tarif_spp/{tarifId} {
      allow get: if isValidId(tarifId) && isStaff();
      allow list: if isStaff();
      allow create: if isValidId(tarifId) && isAdmin() && isValidTarifSpp(incoming()) && incoming().updatedAt == request.time;
      allow update: if isValidId(tarifId) && isAdmin() && isValidTarifSpp(incoming()) && incoming().updatedAt == request.time;
      allow delete: if isValidId(tarifId) && isAdmin();
    }

    match /siswa/{siswaId} {
      allow get: if isValidId(siswaId) && (isStaff() || isOwnedByParentEmail(existing()));
      allow list: if isStaff() || isOwnedByParentEmail(existing());
      allow create: if isValidId(siswaId) && isAdmin() && isValidSiswa(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(siswaId) && isAdmin() && isValidSiswa(incoming()) && incoming().createdAt == existing().createdAt && incoming().updatedAt == request.time;
      allow delete: if isValidId(siswaId) && isAdmin();
    }

    match /tagihan_spp/{tagihanId} {
      allow get: if isValidId(tagihanId) && (isStaff() || isOwnedByParentEmail(existing()));
      allow list: if isStaff() || isOwnedByParentEmail(existing());
      allow create: if isValidId(tagihanId) && isOperator() && isValidTagihanSpp(incoming()) && incoming().createdAt == request.time && incoming().updatedAt == request.time;
      allow update: if isValidId(tagihanId)
        && isOperator()
        && isValidTagihanSpp(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && (
          isAdmin() ||
          incoming().diff(existing()).affectedKeys().hasOnly(['totalTerbayar', 'sisaTagihan', 'status', 'updatedAt'])
        );
      allow delete: if isValidId(tagihanId) && isAdmin();
    }

    match /pembayaran/{pembayaranId} {
      allow get: if isValidId(pembayaranId) && (isStaff() || isOwnedByParentEmail(existing()));
      allow list: if isStaff() || isOwnedByParentEmail(existing());
      allow create: if isValidId(pembayaranId)
        && isOperator()
        && isValidPembayaran(incoming())
        && incoming().petugasUid == request.auth.uid
        && incoming().status == 'sah'
        && incoming().createdAt == request.time;
      allow update: if isValidId(pembayaranId)
        && isOperator()
        && isValidPembayaran(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().noKwitansi == existing().noKwitansi
        && incoming().siswaId == existing().siswaId
        && incoming().totalBayar == existing().totalBayar
        && (
          (
            existing().status == 'sah'
            && incoming().status == 'dibatalkan'
            && incoming().alasanBatal.size() >= 5
            && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'alasanBatal', 'dibatalkanOleh', 'dibatalkanPada'])
          ) ||
          (
            isAdmin()
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['emailOrtu'])
          )
        );
      allow delete: if false;
    }

    match /pembayaran_detail/{detailId} {
      allow get: if isValidId(detailId) && (isStaff() || isOwnedByParentEmail(existing()));
      allow list: if isStaff() || isOwnedByParentEmail(existing());
      allow create: if isValidId(detailId)
        && isOperator()
        && isValidPembayaranDetail(incoming())
        && incoming().status == 'sah'
        && incoming().createdAt == request.time;
      allow update: if isValidId(detailId)
        && isOperator()
        && isValidPembayaranDetail(incoming())
        && incoming().createdAt == existing().createdAt
        && (
          (
            existing().status == 'sah'
            && incoming().status == 'dibatalkan'
            && incoming().diff(existing()).affectedKeys().hasOnly(['status'])
          ) ||
          (
            isAdmin()
            && incoming().pembayaranId == existing().pembayaranId
            && incoming().tagihanId == existing().tagihanId
            && incoming().siswaId == existing().siswaId
            && incoming().status == existing().status
            && incoming().diff(existing()).affectedKeys().hasOnly(['emailOrtu'])
          )
        );
      allow delete: if false;
    }

    match /pembayaran_ortu/{pengajuanId} {
      allow get: if isValidId(pengajuanId) && (isStaff() || isOwnedByParentEmail(existing()));
      allow list: if isStaff() || isOwnedByParentEmail(existing());
      allow create: if isValidId(pengajuanId)
        && isVerified()
        && isValidPembayaranOrtu(incoming())
        && incoming().orangTuaUid == request.auth.uid
        && incoming().status == 'menunggu_verifikasi'
        && incoming().pembayaranId == ''
        && incoming().noKwitansi == ''
        && incoming().diprosesOleh == ''
        && incoming().diprosesPada == ''
        && incoming().alasanTolak == ''
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && exists(/databases/$(database)/documents/siswa/$(incoming().siswaId))
        && (
          isAdmin() ||
          (
            isParent()
            && incoming().emailOrtu == authEmail()
            && get(/databases/$(database)/documents/siswa/$(incoming().siswaId)).data.emailOrtu == authEmail()
          )
        );
      allow update: if isValidId(pengajuanId)
        && isVerified()
        && isValidPembayaranOrtu(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().kodePengajuan == existing().kodePengajuan
        && incoming().orangTuaUid == existing().orangTuaUid
        && incoming().emailOrtu == existing().emailOrtu
        && incoming().siswaId == existing().siswaId
        && incoming().totalBayar == existing().totalBayar
        && existing().status == 'menunggu_verifikasi'
        && (
          (
            isOperator()
            && incoming().status in ['diverifikasi', 'ditolak']
            && (incoming().status != 'ditolak' || incoming().alasanTolak.size() >= 5)
            && (incoming().status != 'diverifikasi' || (incoming().pembayaranId.size() >= 5 && incoming().noKwitansi.size() >= 5))
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'status', 'pembayaranId', 'noKwitansi', 'diprosesOleh', 'diprosesPada', 'alasanTolak',
              'midtransTransactionStatus', 'midtransPaymentType', 'updatedAt'
            ])
          ) ||
          (
            (isAdmin() || isOwnedByParentEmail(existing()))
            && existing().kanal == 'midtrans'
            && incoming().status == 'menunggu_verifikasi'
            && incoming().diff(existing()).affectedKeys().hasOnly([
              'midtransTransactionStatus', 'midtransPaymentType', 'updatedAt'
            ])
          )
        );
      allow delete: if false;
    }

    match /log_aktivitas/{logId} {
      allow get: if isValidId(logId) && (isAdmin() || isKepsek());
      allow list: if isAdmin() || isKepsek();
      allow create: if isValidId(logId)
        && isValidLogAktivitas(incoming())
        && incoming().createdAt == request.time
        && (
          isStaff() ||
          (isParent() && incoming().aksi == 'CREATE' && incoming().entitas == 'pembayaran_ortu')
        );
      allow update: if false;
      allow delete: if false;
    }
  }
}
